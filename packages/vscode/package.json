{
  "name": "@groks-beard/vscode",
  "displayName": "Grok's Beard",
  "publisher": "early-effect",
  "description": "Effect-first VS Code / Cursor client for Grok Build",
  "icon": "media/logo.png",
  "version": "0.1.2",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/early-effect/groks-beard.git"
  },
  "homepage": "https://github.com/early-effect/groks-beard",
  "bugs": {
    "url": "https://github.com/early-effect/groks-beard/issues"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "grok",
    "grok build",
    "ai",
    "agent",
    "cursor"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "groks-beard",
          "title": "Grok's Beard",
          "icon": "media/beard.svg",
          "when": "groksBeard.useActivityBar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "groks-beard-secondary",
          "title": "Grok's Beard",
          "icon": "media/beard.svg",
          "when": "!groksBeard.useActivityBar"
        }
      ]
    },
    "views": {
      "groks-beard": [
        {
          "type": "webview",
          "id": "groksBeard.chat",
          "name": "Grok's Beard",
          "when": "groksBeard.useActivityBar"
        },
        {
          "id": "groksBeard.changes",
          "name": "Grok Changes",
          "when": "groksBeard.useActivityBar && groksBeard.changesPane"
        }
      ],
      "groks-beard-secondary": [
        {
          "type": "webview",
          "id": "groksBeard.chatSecondary",
          "name": "Grok's Beard",
          "when": "!groksBeard.useActivityBar"
        },
        {
          "id": "groksBeard.changesSecondary",
          "name": "Grok Changes",
          "when": "!groksBeard.useActivityBar && groksBeard.changesPane"
        }
      ]
    },
    "commands": [
      {
        "command": "groksBeard.open",
        "title": "Grok's Beard: Open"
      },
      {
        "command": "groksBeard.cancel",
        "title": "Grok's Beard: Stop"
      },
      {
        "command": "groksBeard.cycleMode",
        "title": "Grok's Beard: Cycle Mode"
      },
      {
        "command": "groksBeard.openSettings",
        "title": "Grok's Beard: Open Settings"
      },
      {
        "command": "groksBeard.addSelection",
        "title": "Grok's Beard: Add Selection to Chat"
      },
      {
        "command": "groksBeard.addFile",
        "title": "Grok's Beard: Add File to Chat"
      },
      {
        "command": "groksBeard.copySelectionAsGrokRef",
        "title": "Grok's Beard: Copy Selection as Grok @ ref"
      },
      {
        "command": "groksBeard.openDiff",
        "title": "Grok's Beard: Open Diff"
      },
      {
        "command": "groksBeard.openChangeDiff",
        "title": "Grok's Beard: Open Change Diff"
      },
      {
        "command": "groksBeard.openChangesReview",
        "title": "Grok's Beard: Review Changes"
      },
      {
        "command": "groksBeard.keepChange",
        "title": "Grok's Beard: Keep Change",
        "icon": "$(check)"
      },
      {
        "command": "groksBeard.keepAll",
        "title": "Grok's Beard: Keep All"
      },
      {
        "command": "groksBeard.undoChange",
        "title": "Grok's Beard: Undo Change",
        "icon": "$(discard)"
      },
      {
        "command": "groksBeard.undoAll",
        "title": "Grok's Beard: Undo All"
      },
      {
        "command": "groksBeard.commitChange",
        "title": "Grok's Beard: Commit Change",
        "icon": "$(commit)"
      },
      {
        "command": "groksBeard.commitChanges",
        "title": "Grok's Beard: Commit Changes",
        "icon": "$(commit)"
      },
      {
        "command": "groksBeard.enableTuiBridge",
        "title": "Grok's Beard: Enable TUI Bridge"
      },
      {
        "command": "groksBeard.disableTuiBridge",
        "title": "Grok's Beard: Disable TUI Bridge"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "groksBeard.keepChange",
          "when": "(view == groksBeard.changes || view == groksBeard.changesSecondary) && viewItem =~ /^changeFile/",
          "group": "inline"
        },
        {
          "command": "groksBeard.undoChange",
          "when": "(view == groksBeard.changes || view == groksBeard.changesSecondary) && viewItem == changeFile",
          "group": "inline"
        },
        {
          "command": "groksBeard.keepAll",
          "when": "(view == groksBeard.changes || view == groksBeard.changesSecondary) && viewItem =~ /^changeTurn/",
          "group": "inline"
        },
        {
          "command": "groksBeard.undoAll",
          "when": "(view == groksBeard.changes || view == groksBeard.changesSecondary) && viewItem == changeTurn",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "groksBeard.addSelection",
          "when": "editorHasSelection",
          "group": "groksBeard@1"
        }
      ],
      "editor/title": [
        {
          "command": "groksBeard.keepChange",
          "when": "isInDiffEditor && (resourceScheme == beard-proposed || resourceScheme == beard-original)",
          "group": "navigation@1"
        },
        {
          "command": "groksBeard.undoChange",
          "when": "isInDiffEditor && (resourceScheme == beard-proposed || resourceScheme == beard-original)",
          "group": "navigation@2"
        },
        {
          "command": "groksBeard.commitChange",
          "when": "isInDiffEditor && (resourceScheme == beard-proposed || resourceScheme == beard-original)",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Grok's Beard",
      "properties": {
        "groksBeard.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the grok binary. Empty means auto-discover."
        },
        "groksBeard.nodePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to Node for the MCP proxy. Never process.execPath (that is Code/Cursor)."
        },
        "groksBeard.includeActiveFileByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Attach the active editor as an @path chip when sending with no other chips."
        },
        "groksBeard.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "When true, Enter inserts a newline and Ctrl/Cmd+Enter sends."
        },
        "groksBeard.changesPresentation": {
          "type": "string",
          "enum": ["toast", "pane"],
          "enumDescriptions": [
            "Compact toast in chat. Click Review to open a changes editor to the left.",
            "Grok Changes split pane under chat in the sidebar."
          ],
          "default": "toast",
          "description": "Where pending Grok file changes appear."
        }
      }
    },
    "markdown.previewScripts": [
      "./media/markdown-preview-selection.js"
    ],
    "keybindings": [
      {
        "command": "groksBeard.open",
        "key": "ctrl+;",
        "mac": "cmd+;"
      },
      {
        "command": "groksBeard.addSelection",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "groksBeard.cancel",
        "key": "escape",
        "when": "groksBeard.turnRunning && (focusedView == groksBeard.chat || focusedView == groksBeard.chatSecondary)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:electron": "vitest run test/contributions.test.ts test/view-placement.test.ts"
  },
  "dependencies": {
    "@groks-beard/acp": "workspace:*",
    "@groks-beard/core": "workspace:*",
    "@groks-beard/mcp": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^24.5.2",
    "@types/vscode": "^1.105.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
