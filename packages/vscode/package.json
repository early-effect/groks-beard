{
  "name": "@groks-beard/vscode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "groksBeard.open",
        "title": "Grok's Beard: Open"
      }
    ],
    "keybindings": [
      {
        "command": "groksBeard.open",
        "key": "ctrl+;",
        "mac": "cmd+;"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@groks-beard/acp": "workspace:*",
    "@groks-beard/core": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^24.5.2",
    "@types/vscode": "^1.105.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
